<div id="catlinks" class="catlinks" data-mw="interface">
	{{#data-category-normal}}
	<div id="{{id}}" class="{{class}}">
		<span class="mt-cat-label">Categories</span>
		<ul>{{#array-items}}<li>{{{html}}}</li>{{/array-items}}</ul>
	</div>
	{{/data-category-normal}}
	{{#data-category-hidden}}
	<div id="{{id}}" class="{{class}}">
		<span class="mt-cat-label">Hidden categories</span>
		<ul>{{#array-items}}<li>{{{html}}}</li>{{/array-items}}</ul>
	</div>
	{{/data-category-hidden}}
</div>
